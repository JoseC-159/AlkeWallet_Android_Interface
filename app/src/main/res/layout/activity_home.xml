<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3A404A">

    <!-- Header: Saludo y Avatar -->
    <ImageView
        android:id="@+id/imgProfileHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Foto de perfil"
        android:src="@drawable/ic_avatar_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="¡Hola,"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@+id/imgProfileHome"
        app:layout_constraintTop_toTopOf="@+id/imgProfileHome" />

    <TextView
        android:id="@+id/txtUserNameHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Usuario!"
        android:textColor="#FFFF00"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/txtGreeting"
        app:layout_constraintTop_toBottomOf="@+id/txtGreeting" />

    <!-- Botón Ver Perfil en Header -->
    <Button
        android:id="@+id/btnViewProfileHeader"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="0dp"
        android:text="Ver perfil"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/imgProfileHome"
        app:layout_constraintEnd_toStartOf="@+id/icNotification"
        app:layout_constraintTop_toTopOf="@+id/imgProfileHome" />

    <ImageView
        android:id="@+id/icNotification"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="24dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Notificaciones"
        android:src="@drawable/notifications_icon"
        app:layout_constraintBottom_toBottomOf="@+id/imgProfileHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imgProfileHome" />

    <!-- Balance Total -->
    <TextView
        android:id="@+id/txtBalanceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Balance Total"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/imgProfileHome"
        app:layout_constraintTop_toBottomOf="@+id/imgProfileHome" />

    <TextView
        android:id="@+id/txtBalanceAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textColor="#FFFF00"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/txtBalanceLabel"
        app:layout_constraintTop_toBottomOf="@+id/txtBalanceLabel" />

    <!-- Card Blanco Inferior -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtBalanceAmount">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Botones de Acción -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSendMoneyHome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rounded_accent"
                    android:text="Enviar dinero"
                    android:textAllCaps="false"
                    android:textColor="#3A404A"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRequestMoneyHome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rounded_primary"
                    android:text="Ingresar dinero"
                    android:textAllCaps="false"
                    android:textColor="#FFFF00"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="Últimas transacciones"
                android:textColor="#3A404A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Vista de Transacciones (Con Scroll) -->
            <ScrollView
                android:id="@+id/layoutTransactionsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>

            <!-- Vista de Estado Vacío -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Sin transacciones"
                    android:src="@drawable/ic_empty_history"
                    app:tint="#CCCCCC" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No tienes transacciones recientes"
                    android:textColor="#888888"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>