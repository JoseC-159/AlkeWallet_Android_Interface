<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3A404A"> <!-- Fondo Plomo -->

    <!-- Header: Saludo, Avatar y Notificación -->
    <ImageView
        android:id="@+id/imgProfileHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:contentDescription="Foto de perfil"
        android:src="@drawable/ic_avatar_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="¡Hola,"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toEndOf="@+id/imgProfileHome"
        app:layout_constraintTop_toTopOf="@+id/imgProfileHome" />

    <TextView
        android:id="@+id/txtUserNameHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Usuario!"
        android:textColor="#FFFF00"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/txtGreeting"
        app:layout_constraintTop_toBottomOf="@+id/txtGreeting" />

    <!-- Etiqueta explicativa Ver Perfil -->
    <TextView
        android:id="@+id/txtSeeProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ver perfil ›"
        android:textColor="#CCCCCC"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@+id/txtGreeting"
        app:layout_constraintTop_toBottomOf="@+id/txtUserNameHome" />

    <ImageView
        android:id="@+id/icNotification"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="Notificaciones"
        android:src="@drawable/notifications_icon"
        app:layout_constraintBottom_toBottomOf="@+id/imgProfileHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imgProfileHome" />

    <!-- Sección de Saldo/Balance -->
    <TextView
        android:id="@+id/txtBalanceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Balance Total"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/imgProfileHome"
        app:layout_constraintTop_toBottomOf="@+id/txtSeeProfile" />

    <TextView
        android:id="@+id/txtBalanceAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$555.57"
        android:textColor="#FFFF00"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/txtBalanceLabel"
        app:layout_constraintTop_toBottomOf="@+id/txtBalanceLabel" />

    <!-- Sector Blanco Inferior con Botones y Lista -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtBalanceAmount">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Botones de Acción (Enviar / Ingresar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSendMoneyHome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rounded_accent"
                    android:text="Enviar dinero"
                    android:textAllCaps="false"
                    android:textColor="#3A404A"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRequestMoneyHome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rounded_primary"
                    android:text="Ingresar dinero"
                    android:textAllCaps="false"
                    android:textColor="#FFFF00"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="Últimas transacciones"
                android:textColor="#3A404A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Contenedor desplegable estático con transacciones predeterminadas -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_transaction" />
                    <include layout="@layout/item_transaction" />
                    <include layout="@layout/item_transaction" />
                    <include layout="@layout/item_transaction" />

                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>